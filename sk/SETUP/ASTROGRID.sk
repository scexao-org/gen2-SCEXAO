:Header
    OBE_ID=SCEXAO
    OBE_MODE=SETUP
    COMMAND=OAP1
    Script_ID=SETUP02
    Script_Version=1.0
    Script_Author=Axel Reid
    Script_Update=2026/08/05

:Parameter
    STATE=OFF
    *STATE=ON,OFF
    AMPLITUDE=NOP
    MODE=IMAGING
    *MODE=PDI,IMAGING

:Command
:start

from "SCEXAO_Helpers" import strip
asn mystatus1 = @strip("!SCX.GRID.STAT")
asn mystatus2 = @strip("!SCX.GRID.AMP")
asn mystatus3 = @strip("!SCX.GRID.SEP")

# local function
def execute_command1(comparison1){
    EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.GRID.STAT" COMPARISON1="@comparison1";
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3=Clear;
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3="Result: State= !SCX.GRID.STAT";
}

def execute_command2(comparison2){
    EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.GRID.SEP" COMPARISON1="@comparison2";
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo5=Clear;
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo5="Result: Separation= !SCX.GRID.SEP lambda";
}

Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo1=Clear ObsInfo2=Clear ObsInfo3=Clear ObsInfo4=Clear ObsInfo5=Clear;
Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo1="Changing ASTROGRID" ObsInfo2=Clear ObsInfo3="CMD: State=$STATE" ObsInfo4="Amplitude= $AMPLITUDE nm" ObsInfo5="Mode= $MODE";

:main_start

    IF "$MODE" == "PDI"
        asn mode = "10.3"
    ELIF "$MODE" == "IMAGING"
        asn mode = "15.5"
    ENDIF

    IF @mystatus1 == $STATE AND @mystatus2 == $AMPLITUDE AND @mystatus3 == @mode
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3="Already in Position";
    ELSE

        # send command
        EXEC SCEXAO ASTROGRID STATE=$STATE AMPlITUDE=$AMPLITUDE MODE=$MODE;

        # change the screen
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3=Clear ObsInfo4=Clear ObsInfo5=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3="Changing..." ObsInfo4="Changing..." ObsInfo5="Changing...";

        # state check
        IF "$STATE" == "OFF"
            # must assign to variable to excetue local function
            asn why_do_I_exist1 = @execute_command1(comparison1="OFF")
        ELSE
            IF "$STATE" == "ON"
                # must assign to variable to excetue local function
                asn why_do_I_exist1 = @execute_command1(comparison1="ON")
            ENDIF

            # amplitude check
            asn amplitude = $AMPLITUDE / 1000
            EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.GRID.AMP" COMPARISON1="@amplitude";
            Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
            Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Result: Amplitude= !SCX.GRID.AMP";

            # mode check
            IF "$MODE" == "PDI"
                # must assign to variable to excetue local function
                asn why_do_I_exist2 = @execute_command2(comparison2="10.3")
            ELIF "$MODE" == "IMAGING"
                # must assign to variable to excetue local function
                asn why_do_I_exist2 = @execute_command2(comparison2="15.5")
            ENDIF
        ENDIF
    ENDIF
:main_end

Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo2="Done";

:end
