:Header
    OBE_ID=SCEXAO
    OBE_MODE=SETUP
    COMMAND=STARTUP_SCEXAO
    Script_ID=SETUP10
    Script_Version=1.0
    Script_Author=Axel Reid
    Script_Update=2026/08/14

:Parameter
    MODE=NOP
    *MODE=CALIBRATION,ONSKY

:Command
:start

# imports
from "SCEXAO_Helpers" import strip

# remove whitespaces from current status
asn pywfs_flt = @strip("!SCX.PYWFS.FLT")
asn superk_status = @strip("!SCX.SRC.EN")
asn astrogrid_state = @strip("!SCX.GRID.STAT")
asn src_pos = @strip("!SCX.SRC.FIB")
asn oap1_pos = @strip("!SCX.OAP1")
asn fpm_slot = @strip("!SCX.FPM")
asn lyot_slot = @strip("!SCX.LYOT")
asn charis_pko_slot = @strip("!SCX.CHARIS.PKO")
asn ircam_flt_slot = @strip("!SCX.IRCAM.FLT")
asn ircam_fcs_mode = @strip("!SCX.IRCAM.FCS")
asn apapane_pko_slot = @strip("!SCX.APAPANE.PKO")
asn field_stop_pos = @strip("!SCX.FSTOP")
asn charis_wol_pos = @strip("!SCX.CHARIS.WOL")
asn ircam_wol_pos = @strip("!SCX.IRCAM.WOL")
asn reach_pko_pos @strip("!SCX.REACH.PKO")

# local function
def execute_onsky(x){
# start text
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3=Clear;
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3="Setting-up on-sky...";

# commands    
    EXEC SCEXAO WFS_ACQUISITION MODE="START";
    # no status
    IF @pywfs_flt == "OPEN"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="PyWFS filter already in position";
    ELSE
        EXEC SCEXAO PYWFS_FILTER SLOT="OPEN";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.PYWFS.FLT" COMPARISON1="OPEN";
    ENDIF
    EXEC SCEXAO SETUP_PYWFS FREQUENCY="1000" MOD_AMP="0.4";
    EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.PYWFS.FREQ" COMPARISON1="1000";
    EXEC SCEXAO PYWFS_EMGAIN EM_GAIN="1";
    # no status
    IF @superk_status == "OFF"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Source already turned off";
    ELSE
        EXEC SCEXAO SUPERK POWER="OFF";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.SRC.EN" COMPARISON1="OFF";
    ENDIF
    EXEC SCEXAO SRC_FLUX MODE="DEFAULT";
    # no status
    IF @astrogrid_state == "OFF"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="astrogrid already turned off";
    ELSE
        EXEC SCEXAO ASTROGRID STATE="OFF" AMPlITUDE="0.05" MODE="PDI";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.GRID.STAT" COMPARISON1="OFF";
    ENDIF
    EXEC SCEXAO SCEXAO_DM STATE="FLAT";
    # no status
    IF @src_pos == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Source Fib already in position";
    ELSE
        EXEC SCEXAO SRC_FIB POSITION="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.SRC.FIB" COMPARISON1="OUT";
    ENDIF
    IF @oap1_pos == "AO3k-NIRWFS"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="OAP1 already in position";
    ELSE
        EXEC SCEXAO OAP1 POSITION="NIRWFS";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.OAP1" COMPARISON1="AO3k-NIRWFS";
    ENDIF
    IF @fpm_slot == "OPEN"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="FPM already in position";
    ELSE
        EXEC SCEXAO FPM SLOT="OPEN";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.FPM" COMPARISON1="OPEN";
    ENDIF
    IF @lyot_slot == "OPEN"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Lyot already in position";
    ELSE
        EXEC SCEXAO LYOT SLOT="OPEN";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.LYOT" COMPARISON1="OPEN";
    ENDIF
    IF @charis_pko_slot == "1.12 um LP"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="CHARIS Pickoff already in position";
    ELSE
        EXEC SCEXAO CHARIS_PICKOFF SLOT="1.12UMLP";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.CHARIS.PKO" COMPARISON1="1.12 um LP";
    ENDIF
    IF @ircam_flt_slot == "OPEN"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="IRCam filter already in position";
    ELSE
        EXEC SCEXAO IRCAM_FILTER SLOT="OPEN";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.IRCAM.FLT" COMPARISON1="OPEN";
    ENDIF
    IF @ircam_fcs_mode == "Palila focus"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="IRCam Focus already in position";
    ELSE
        EXEC SCEXAO IRCAM_FCS MODE="PALILA";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.IRCAM.FCS" COMPARISON1="Palila focus";
    ENDIF
    IF @apapane_pko_slot == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Apapane pickoff already in position";
    ELSE
        EXEC SCEXAO APAPANE_PICKOFF SLOT="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.APAPANE.PKO" COMPARISON1="OUT";
    ENDIF
    IF @field_stop_pos == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Field stop already in position";
    ELSE
        EXEC SCEXAO FIELD_STOP POSITION="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.FSTOP" COMPARISON1="OUT";
    ENDIF
    IF @charis_wol_pos == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="CHARIS Wollaston already in position";
    ELSE
        EXEC SCEXAO CHARIS_WOLLASTON POSITION="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.CHARIS.WOL" COMPARISON1="OUT";
    ENDIF
    IF @ircam_wol_pos == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="IRCam Wollaston already in position";
    ELSE
        EXEC SCEXAO IRCAM_WOLLASTON POSITION="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.IRCAM.WOL" COMPARISON1="OUT";
    ENDIF
    IF @reach_pko_pos == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Reach Pickoff already in position";
    ELSE
        EXEC SCEXAO REACH_PICKOFF POSITION="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.REACH.PKO" COMPARISON1="OUT";
    ENDIF
    EXEC SCEXAO PALILA_PARAMETERS NDR="255";
    # no status

# end text
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3=Clear;
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3="Setup complete";
}

def execute_calibration(x){
# start text
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3=Clear;
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3="Setting-up for Calibration...";

# commands    
    EXEC SCEXAO WFS_ACQUISITION MODE="START";
    # no status
    IF @pywfs_flt == "OPEN"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="PyWFS filter already in position";
    ELSE
        EXEC SCEXAO PYWFS_FILTER SLOT="OPEN";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.PYWFS.FLT" COMPARISON1="OPEN";
    ENDIF
    EXEC SCEXAO SETUP_PYWFS FREQUENCY="1000" MOD_AMP="0.4";
    EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.PYWFS.FREQ" COMPARISON1="1000";
    EXEC SCEXAO PYWFS_EMGAIN EM_GAIN="1";
    # no status
    IF @superk_status == "OFF"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Source already turned off";
    ELSE
        EXEC SCEXAO SUPERK POWER="OFF";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.SRC.EN" COMPARISON1="OFF";
    ENDIF
    EXEC SCEXAO SRC_FLUX MODE="DEFAULT";
    # no status
    IF @astrogrid_state == "OFF"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="astrogrid already turned off";
    ELSE
        EXEC SCEXAO ASTROGRID STATE="OFF" AMPlITUDE="0.05" MODE="PDI";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.GRID.STAT" COMPARISON1="OFF";
    ENDIF
    EXEC SCEXAO SCEXAO_DM STATE="FLAT";
    # no status
    IF @src_pos == "IN"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Source Fib already in position";
    ELSE
        EXEC SCEXAO SRC_FIB POSITION="IN";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.SRC.FIB" COMPARISON1="IN";
    ENDIF
    IF @oap1_pos == "INT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="OAP1 already in position";
    ELSE
        EXEC SCEXAO OAP1 POSITION="INT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.OAP1" COMPARISON1="INT";
    ENDIF
    IF @fpm_slot == "OPEN"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="FPM already in position";
    ELSE
        EXEC SCEXAO FPM SLOT="OPEN";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.FPM" COMPARISON1="OPEN";
    ENDIF
    IF @lyot_slot == "OPEN"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Lyot already in position";
    ELSE
        EXEC SCEXAO LYOT SLOT="OPEN";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.LYOT" COMPARISON1="OPEN";
    ENDIF
    IF @charis_pko_slot == "1.12 um LP"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="CHARIS Pickoff already in position";
    ELSE
        EXEC SCEXAO CHARIS_PICKOFF SLOT="1.12UMLP";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.CHARIS.PKO" COMPARISON1="1.12 um LP";
    ENDIF
    IF @ircam_flt_slot == "OPEN"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="IRCam filter already in position";
    ELSE
        EXEC SCEXAO IRCAM_FILTER SLOT="OPEN";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.IRCAM.FLT" COMPARISON1="OPEN";
    ENDIF
    IF @ircam_fcs_mode == "Palila focus"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="IRCam Focus already in position";
    ELSE
        EXEC SCEXAO IRCAM_FCS MODE="PALILA";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.IRCAM.FCS" COMPARISON1="Palila focus";
    ENDIF
    IF @apapane_pko_slot == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Apapane pickoff already in position";
    ELSE
        EXEC SCEXAO APAPANE_PICKOFF SLOT="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.APAPANE.PKO" COMPARISON1="OUT";
    ENDIF
    IF @field_stop_pos == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Field stop already in position";
    ELSE
        EXEC SCEXAO FIELD_STOP POSITION="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.FSTOP" COMPARISON1="OUT";
    ENDIF
    IF @charis_wol_pos == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="CHARIS Wollaston already in position";
    ELSE
        EXEC SCEXAO CHARIS_WOLLASTON POSITION="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.CHARIS.WOL" COMPARISON1="OUT";
    ENDIF
    IF @ircam_wol_pos == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="IRCam Wollaston already in position";
    ELSE
        EXEC SCEXAO IRCAM_WOLLASTON POSITION="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.IRCAM.WOL" COMPARISON1="OUT";
    ENDIF
    IF @reach_pko_pos == "OUT"
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4=Clear;
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo4="Reach Pickoff already in position";
    ELSE
        EXEC SCEXAO REACH_PICKOFF POSITION="OUT";
        EXEC SCEXAO CHECK_STATUS TIMEOUT_COUNTER=100 CONDITION="EQUALS" STATUS_VAR1="SCX.REACH.PKO" COMPARISON1="OUT";
    ENDIF
    EXEC SCEXAO PALILA_PARAMETERS NDR="255";
    # no status

# end text
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3=Clear;
    Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo3="Setup for Calibration complete";
}

Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo1=Clear ObsInfo2=Clear ObsInfo3=Clear ObsInfo4=Clear ObsInfo5=Clear;
Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo1="Starting-up SCExAO" ObsInfo2=Clear ObsInfo3="CMD: Mode=$MODE" ObsInfo4=Clear ObsInfo5=Clear;

:main_start
    *IF "$MODE" == "CALIBRATION"

        # must assign to variable to excetue local function
        # replace 'none' with the value of the status alias  
        asn why_do_I_exist = @execute_calibration(x="NA")
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo2="Done";

    *ELIF "$MODE" == "ONSKY"

        # must assign to variable to excetue local function
        # replace 'none' with the value of the status alias
        asn why_do_I_exist = @execute_onsky(x="NA")
        Exec OBS Set_Message Instrument_Name=!FITS.SBR.MAINOBCP ObsInfo2="Done";

    *ENDIF

:main_end

:end
